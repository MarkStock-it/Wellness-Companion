# Optional server-managed fallback. The app normally asks each user for a key
# and keeps it in browser sessionStorage instead of bundling it into the app.
# Choose openai, gemini, or deepseek for chat and summaries.
AI_PROVIDER=openai
# Photo analysis needs a multimodal provider: openai or gemini.
AI_VISION_PROVIDER=openai

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-terra

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
